% This function processes real data and creates a new dataset.
function process_dataset()
    % We run the main function
    main();

    %----------------------------------------------------------------------
    %----------------------------------------------------------------------
    %----------------------------------------------------------------------

    % Main function
    function main()
        % We delete variables and close windows
        clear all;
        close all;
        clc;

        % We suppress warning about asymmetry of detected checkerboards
        warning('off', 'vision:calibrate:boardShouldBeAsymmetric');

        % We add required paths recursively
        addpath_recurse(['..' filesep 'common_tools']);

        % We create a parallel pool if needed
        if isempty(gcp('nocreate'))
            parpool('IdleTimeout', 60*24*7);
        end

        % Parameters
        verbose              = false;                                                              % Enables/disables display of messages on command window (true or false)
        grayscale_conversion = false;                                                              % Enables/disables grayscale conversion of both fresco and fragment images (true or false)
        input_frescoes_dir   = ['..' filesep '..' filesep 'data' filesep 'real' filesep 'input'];  % Input frescoes directory (string)
        output_frescoes_dir  = ['..' filesep '..' filesep 'data' filesep 'real' filesep 'output']; % Output frescoes directory (string)
        detection_threshold  = 50;                                                                 % Threshold for detecting fragments and freconstructed fresco (in [0,255])
        connectivity         = 8;                                                                  % Connectivity used in morphological operations (>0)
        scaling_factor       = 1.0;                                                                % Resizes both fragment and fresco images by this factor (!=0)
        padding_factor       = 1.2;                                                                % Padding factor applied to each fragment image (!=0)
        checkerboard_dims    = [5,5];                                                              % Expected number of corners in checkerboards (pair of positive integers)
        frags_dir_name       = 'frag_eroded';                                                      % Directory name where fragment images are stored
        geo_constraints_name = 'geometric_constraints.txt';                                        % Filename where geometric constraints are stored (here none)
        gen_parameters_name  = 'gen_parameters.txt';                                               % Filename where generation parameters are stored

        % We check if the fresco directory exists
        if ~isfolder(input_frescoes_dir)
            error(sprintf('Unable to find the input frescoes directory %s', input_frescoes_dir));
        end

        % We create the output directory if necessary
        if ~isfolder(output_frescoes_dir)
            mkdir(output_frescoes_dir);
        else
            rmdir(output_frescoes_dir, 's');
        end

        % We loop over fresco directories
        frescoes_dirs = get_matching_dirs(input_frescoes_dir, '.*');

        if isempty(frescoes_dirs)
            error(sprintf('Directory %s is empty', input_frescoes_dir));
        end

        parfor i=1:numel(frescoes_dirs)
            % We set input filenames and directories
            fresco_name     = split(frescoes_dirs{i}, filesep);
            fresco_name     = fresco_name{end};
            input_frags_dir = [frescoes_dirs{i} filesep frags_dir_name];

            % Message
            disp(sprintf('+ %s (%d/%d)', fresco_name, i, numel(frescoes_dirs)));

            % We look for the fresco image filename
            input_fresco_fn = get_matching_files(frescoes_dirs{i}, [fresco_name '.png']);

            if numel(input_fresco_fn)==0
                error(sprintf('Unable to find fresco image in directory %s', frescoes_dirs{i}));
            end

            input_fresco_fn = input_fresco_fn{1};

            % We check if fragments images directory exist
            if ~isfolder(input_frags_dir)
                error(sprintf('Unable to find fragment images directory %s', input_frags_dir));
            end

            % We set output filenames and directories
            output_fresco_dir         = [output_frescoes_dir filesep fresco_name];
            output_frags_dir          = [output_fresco_dir filesep frags_dir_name];
            output_fresco_fn          = [output_fresco_dir filesep fresco_name '.png'];
            output_geo_constraints_fn = [output_frags_dir filesep geo_constraints_name];
            output_gen_parameters_fn  = [output_frags_dir filesep gen_parameters_name];

            % We create the directory where fresco and fragments data are stored
            mkdir(output_fresco_dir);
            mkdir(output_frags_dir);

            % We get the size of the checkerboard in the fresco image
            [fresco_cb_pts,fresco_cb_size] = get_checkerboard(input_fresco_fn, checkerboard_dims);

            % We process the fresco image
            [im_fresco_color,im_fresco_alpha] = process_fresco_image(input_fresco_fn, fresco_cb_pts, scaling_factor, grayscale_conversion, detection_threshold, connectivity);

            %--- debug ---
            %figure, imshow(im_fresco_alpha,[]);
            %figure, imshow(im_fresco_color,[]);
            %-------------

            % We overwrite the file with its alpha channel
            imwrite(im_fresco_color, output_fresco_fn, 'Alpha', im_fresco_alpha);

            % We loop over all fragment image filenames
            frags_fns = get_matching_files(input_frags_dir, '.*\.png');

            if numel(frags_fns)==0
                error(sprintf('No fragment images found in directory %s', input_frags_dir));
            end

            % We loop over fragment images
            for j=1:numel(frags_fns)
                % Message
                input_frag_fn = frags_fns{j};
                msg(sprintf('  + fragment image %d/%d', j, numel(frags_fns)), verbose);

                % We get the size of the checkerboard in the fragment image
                [frag_cb_pts,frag_cb_size] = get_checkerboard(input_frag_fn, checkerboard_dims);

                % We process the fragment image and scale it based on the fresco one accordingly
                [im_frag_color,im_frag_alpha] = process_fragment_image(input_frag_fn, frag_cb_pts, scaling_factor*(fresco_cb_size/frag_cb_size), ...
                                                                       grayscale_conversion, detection_threshold, connectivity, padding_factor);

                %--- debug ---
                %figure, imshow(im_frag_alpha,[]);
                %figure, imshow(im_frag_color,[]);
                %-------------

                % We overwrite the fragment image with its alpha channel
                output_frag_fn = [output_frags_dir filesep sprintf('frag_eroded_%d.png', j-1)];
                imwrite(im_frag_color, output_frag_fn, 'Alpha', im_frag_alpha);

            end

            % We save the parameters used for generating fragment images (none here)
            save_gen_parameters({'mean_frags_gap'}, {double(0.0)}, output_gen_parameters_fn);

            % We save the file constraining the placement of fragment images (no constraints here)
            geometric_constraints = struct('locations', [], 'orientations', []);
            save_geometric_constraints(geometric_constraints, output_geo_constraints_fn);
        end
    end

    % This function returns the pixel coordinates and the size (in pixels) of the checkerboard
    function [cb_pts,cb_size] = get_checkerboard( img_fn, checkerboard_dims )
        [cb_pts,cb_dims] = detectCheckerboardPoints(img_fn, 'PartialDetections', false);

        if isempty(cb_pts) || isempty(cb_dims)
            error(sprintf('Checkerboard not detected or partially detect on image %s', img_fn));
        end

        if any(cb_dims~=checkerboard_dims)
            error(sprintf('The checkerboard in image %s must be of size %dx%d', img_fn, checkerboard_dims(1), checkerboard_dims(2)))
        end

        % We set the checkerboard size as the mean distance between all pairs of detected corner points
        cb_size = mean(pdist(cb_pts));
    end

    % This function returns a processed fragment image with its alpha channel
    function [im_frag_color,im_frag_alpha] = process_fragment_image( frag_fn, cb_pts, scaling_factor, grayscale_conversion, detection_threshold, connectivity, padding_factor )
        % We load the fragment image
        [im_frag_color,~] = load_image(frag_fn, grayscale_conversion);

        if isempty(im_frag_color)
            error(sprintf('Unable to load fragment image %s', frag_fn));
        end

        % We resize the image to speed up computations
        if scaling_factor~=1
            im_frag_color = imresize(im_frag_color, scaling_factor);
            cb_pts        = scaling_factor*cb_pts;
        end

        % We get size and number of channels of fragment image
        img_size    = size(im_frag_color, [1,2]);
        nb_channels = size(im_frag_color,3);

        % We roughly estimate the boundaries of objects by thresholding the grayscale fragment image 
        % and applying morphological operators. The connected component including the corners is discarded
        im_frag_alpha   = rgb2gray(im_frag_color)>detection_threshold;
        im_frag_alpha   = imopen(im_frag_alpha, strel('disk', double(round(0.005*min(img_size)))));
        im_frag_alpha   = imfill(im_frag_alpha, connectivity, 'holes');
        im_markers      = zeros(img_size, 'logical');
        idx             = sub2ind(img_size, round(cb_pts(:,2)), round(cb_pts(:,1)));
        im_markers(idx) = 1;
        im_frag_alpha   = im_frag_alpha-imreconstruct(im_markers, im_frag_alpha, connectivity);

        % We only keep the largest connected component
        cc                           = bwconncomp(im_frag_alpha, connectivity);
        nb_pixels                    = cellfun(@numel, cc.PixelIdxList);
        [~,idx]                      = max(nb_pixels);
        im_tmp                       = zeros(img_size, 'logical');
        im_tmp(cc.PixelIdxList{idx}) = 1;
        im_frag_alpha                = im_tmp;

        % We look pixel coordinates of the fragment and compute its centroid and size
        [rows,cols]   = find(im_frag_alpha>0);
        frag_centroid = round(mean([rows,cols]));
        frag_size     = max(sqrt(sum(([rows,cols]-frag_centroid).^2,2)));

        % We set the half size of the fragment image as an even integer to avoid rounding artifacts with translation vector (see below)
        half_img_frag_size = 2*round(0.5*padding_factor*frag_size);

        % We compute the bounding box encompassing the fragment
        ul_corner = round(frag_centroid-half_img_frag_size);
        lr_corner = round(frag_centroid+half_img_frag_size);
        p         = max([1,1],ul_corner);
        q         = min(img_size,lr_corner);

        % We compute the pixel coordinates of the fragment image encompassing the fragment
        img_frag_size   = lr_corner-ul_corner+1;
        img_frag_center = round(0.5*img_frag_size);
        pp              = p-frag_centroid+img_frag_center;
        qq              = q-frag_centroid+img_frag_center;

        % We trim borders on alpha channel
        im_tmp                          = zeros(img_frag_size, 'logical');
        im_tmp(pp(1):qq(1),pp(2):qq(2)) = im_frag_alpha(p(1):q(1),p(2):q(2));
        im_frag_alpha                   = uint8(255*im_tmp);

        % We trim borders on remaining ones
        im_tmp = zeros(img_frag_size(1), img_frag_size(2), nb_channels, 'uint8');

        for c=1:nb_channels
            im_tmp2                          = zeros(img_frag_size(1), img_frag_size(2), 'uint8');
            im_tmp2(pp(1):qq(1),pp(2):qq(2)) = im_frag_color(p(1):q(1),p(2):q(2),c);
            im_tmp(:,:,c)                    = uint8(double(im_tmp2).*double(im_frag_alpha>0));
        end

        im_frag_color = im_tmp;
    end
end