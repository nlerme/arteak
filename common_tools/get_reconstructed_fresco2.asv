% Function returning the fresco reconstructed from fragments using ground
% truth (consistency check). This function should be only used for
% visualization purposes.
% 
% Inputs:
%   * im_fresco:           multi-channels fresco image (uint8)
%   * frags_infos:         infos about fragments (cell array)
%   * frags_sol:           solution composed of fragments (cell array)
%   * interpolation_type:  interpolation type (string; e.g. nearest, bilinear, bicubic, etc.)
%   * background_color:    background color of reconstructed fresco (in {0,...,255}^c)
% 
% Outputs:
%   * im_rec_frags1:  reconstructed fresco with colored fragments (uint8 color image)
%   * im_rec_frags2:  reconstructed fresco with colored fragments (uint8 color image)
function [im_rec_frags1,im_rec_frags2] = get_reconstructed_fresco2( im_fresco, frags_infos, frags_sol, interpolation_type, background_color )
    % We get the size of fresco and number of channels
    fresco_size = size(im_fresco);
    nb_channels = size(im_fresco,3);

    % We check consistency between background color and number of channels of fresco image
    if nb_channels ~= length(background_color)
        im_rec_frags1 = [];
        im_rec_frags2 = [];
        return;
    end

    % We allocate memory for storing results
    im_filled_frags = zeros(fresco_size(1:2), 'logical');
    im_rec_frags1   = ones(fresco_size);
    im_rec_frags2   = ones(fresco_size);

    for k=1:nb_channels
        im_rec_frags1(:,:,k) = im_rec_frags1(:,:,k)*background_color(k);
        im_rec_frags2(:,:,k) = im_rec_frags2(:,:,k)*background_color(k);
    end

    % We loop over fragments in the solution
    for k=1:length(frags_sol)
        % We get the index and image content of fragment
        idx               = frags_sol{k}.idx;
        im_frag_color_ext = frags_infos{idx}.color_ext;
        im_frag_alpha_d   = frags_infos{idx}.alpha_d;

        % We get corresponding pixel coordinates in fresco image and fragment image
        if isempty(frags_sol{k}.fresco_coords) || isempty(frags_sol{k}.frag_coords)
            [fresco_coords,frag_coords] = get_transformed_fragment(im_frag_alpha_d, frags_sol{k}.translation, frags_sol{k}.angle, fresco_size(1:2));
        else
            fresco_coords = frags_sol{k}.fresco_coords;
            frag_coords   = frags_sol{k}.frag_coords;
        end

        % If the fragment lies outside, we discard it from the reconstructed fresco
        if isempty(fresco_coords) || isempty(frag_coords)
            continue;
        end

        % We construct binary image of registered fragment
        fresco_idx                  = sub2ind(fresco_size(1:2), fresco_coords(:,1), fresco_coords(:,2));
        im_frag_t_alpha             = zeros(fresco_size(1:2), 'logical');
        im_frag_t_alpha(fresco_idx) = 1;

        % We construct color image of registered fragment and add it to color fresco reconstruction
        im_tmp                   = (im_frag_t_alpha & im_filled_frags);
        fresco_intersect_idx     = im_tmp(fresco_idx)>0;
        fresco_non_intersect_idx = setdiff(fresco_idx, fresco_intersect_idx);

        frag_coords_intersect     = frag_coords(fresco_intersect_idx,:);
        frag_coords_non_intersect = frag_coords(fresco_non_intersect_idx,:);

        for c=1:nb_channels
            im_tmp2                           = im_rec_frags1(:,:,c);
            im_tmp2(fresco_non_intersect_idx) = interp2(, frag_coords_non_intersect(:,2), frag_coords_non_intersect(:,1), interpolation_type);
            im_rec_frags1(:,:,c)              = im_tmp2;
        end

        % We add resulting fragment image to grayscale fresco reconstruction
        im_filled_frags(fresco_idx) = 1;
    end
end
