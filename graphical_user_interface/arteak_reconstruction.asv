% This function opens a subwindow and deal with fresco reconstruction
function [g_new_frags_sol,g_new_im_rec_color,g_new_im_rec_gray,g_rec_name] = arteak_reconstruction( fh_main )
    % We get GUI data
    g_mydata = guidata(fh_main);

    % We check if all inputs are available
    %if isempty(g_mydata.im_fresco) || isempty(g_mydata.frags_infos)
    %    uiwait(errordlg('A fresco image a set of fragment images must be previously loaded', 'ARTEAK ERROR', 'modal'));
    %    return;
    %end

    % We make as empty returned variables
    g_new_frags_sol    = {};
    g_new_im_rec_color = [];
    g_new_im_rec_gray  = [];
    g_rec_name         = '';

    % Global variables
    %g_results_dir = ['blabla'];
    %g_gt_dir      = ['blibli'];
    [~,fresco_name,~] = fileparts(g_mydata.current_fresco_dir);
    g_results_dir     = [g_mydata.results_root_dir filesep fresco_name];
    g_gt_dir          = g_mydata.current_fresco_dir;

    g_general_parameters = {struct('name', 'verbose', 'label', 'Verbose mode', 'value', false), ...
                            struct('name', 'show_figures', 'label', 'Show figures', 'value', false), ...
                            struct('name', 'recompute_preprocessing', 'label', 'Recompute preprocessing', 'value', true), ...
                            struct('name', 'results_dir', 'label', 'Results directory', 'value', g_results_dir), ...
                            struct('name', 'gt_dir', 'label', 'Ground truth directory', 'value', g_gt_dir), ...
                            struct('name', 'save_ground_truth_results', 'label', 'Save ground truth results', 'value', 1), ...
                            struct('name', 'interpolation_type', 'label', 'Interpolation type', 'value', 'bilinear'), ...
                            struct('name', 'save_intermediate_results', 'label', 'Save intermediate results', 'value', 1), ...
                            struct('name', 'translation_tolerance', 'label', 'Translation tolerance', 'value', 10.0'), ...
                            struct('name', 'angle_tolerance', 'label', 'Angle tolerance', 'value', 5.0), ...
                            struct('name', 'background_color', 'label', 'Background color', 'value', [0,0,0])};

    g_init_parameters = {struct('name', 'recompute_init', 'label', 'Recompute init', 'value', 1), ...
                         struct('name', 'outside_fragment_tolerance', 'label', 'Outside fragment tolerance', 'value', 0.1, 'min', 0.0, 'max', 1.0), ...
                         struct('name', 'fragments_overlap_tolerance', 'label', 'Fragments overlap tolerance', 'value', 0.1, 'min', 0.0, 'max', 1.0), ...
                         struct('name', 'features_detection_threshold1', 'label', 'Features detection - threshold 1', 'value', 0.01, 'min', 0.0), ...
                         struct('name', 'features_detection_threshold2', 'label', 'Features detection - threshold 2', 'value', 0.03, 'min', 0.0), ...
                         struct('name', 'features_extraction_method', 'label', 'Features extraction - method', 'value', 'BRISK'), ...
                         struct('name', 'features_matching_threshold', 'label', 'Features matching - threshold', 'value', 50, 'min', 0.0, 'max', 50.0), ...
                         struct('name', 'features_matching_max_ratio', 'label', 'Features matching - max ratio', 'value', 0.6, 'min', 0.0, 'max', 1.0), ...
                         struct('name', 'features_matching_fresco_padding', 'label', 'Features matching - fresco padding', 'value', 18, 'min', 0), ...
                         struct('name', 'features_matching_dilation_rate', 'label', 'Features matching - dilation rate', 'value', 0.5, 'min', 0.0, 'max', 1.0), ...
                         struct('name', 'color_matching_nb_bins', 'label', 'Color matching - nb bins', 'value', 16, 'min', 1, 'max', 256), ...
                         struct('name', 'color_matching_nb_rectangles', 'label', 'Color matching - nb rectangles', 'value', 1), ...
                         struct('name', 'color_matching_dilatation_radius', 'label', 'Color matching - dilation radius', 'value', 3, 'min', 0), ...
                         struct('name', 'color_matching_threshold', 'label', 'Color matching - threshold', 'value', 0.8, 'min', 0.0, 'max', 1.0)};

    g_mpp_parameters = {struct('name', 'recompute_mpp', 'label', 'Recompute MPP', 'value', 1, 'min', 0, 'max', 1), ...
                        struct('name', 'beta_d', 'label', 'beta_{d}', 'value', 1.0, 'min', 0.0), ...
                        struct('name', 'beta_inc', 'label', 'beta_{inc}', 'value', 1.0, 'min', 0.0), ...
                        struct('name', 'beta_c', 'label', 'beta_{c}', 'value', 1.0, 'min', 0.0), ...
                        struct('name', 'beta_no', 'label', 'beta_{no}', 'value', 1.0, 'min', 0.0), ...
                        struct('name', 'beta_sf', 'label', 'beta_{sf}', 'value', 1.0, 'min', 0.0), ...
                        struct('name', 'lambda', 'label', 'lambda', 'value', 1.0, 'min', 0.00000001), ...
                        struct('name', 'mu', 'label', 'mu', 'value', '1.0', 'min', -1.0, 'max', 1.0), ...
                        struct('name', 'nb_iterations', 'label', 'Nb iterations', 'value', 1, 'min', 0), ...
                        struct('name', 'nb_fragments', 'label', 'Nb fragments', 'value', 1, 'min', 1)};

    % We create the subwindow
    g_fh_rec = figure('menubar', 'none', ...
                      'toolbar', 'none', ...
                      'color', get(0, 'defaultuicontrolbackgroundcolor'), ...
                      'name', 'ARTEAK - Reconstruction', ...
                      'units', 'normalized', ...
                      'position', [0 0 1 1], ...
                      'closerequestfcn', @quit_callback);

    %-------------------------

    g_general_parameters_panel = uipanel('parent', g_fh_rec, ...
                                         'title', 'General parameters', ...
                                         'fontsize', 11, ...
                                         'fontweight', 'bold', ...
                                         'units', 'normalized', ...
                                         'position', [0.01 0.64 0.3 0.35]);

    g_general_parameters_label = cell(1,numel(g_general_parameters));
    g_general_parameters_edit  = cell(1,numel(g_general_parameters));

    for k=1:numel(g_general_parameters)
        g_general_parameters_label{k} = uicontrol('parent', g_general_parameters_panel, ...
                                                  'style', 'text', ...
                                                  'units', 'normalized', ...
                                                  'position', [0.01 0.92-(k-1)/numel(g_general_parameters) 0.5 0.07], ...
                                                  'fontsize', 11, ...
                                                  'horizontalalignment', 'right', ...
                                                  'string', [g_general_parameters{k}.label ':']);

         g_general_parameters_edit{k} = uicontrol('parent', g_general_parameters_panel, ...
                                                  'style', 'edit', ...
                                                  'tag', sprintf('general_%d', k), ...
                                                  'units', 'normalized', ...
                                                  'position', [0.55 0.92-(k-1)/numel(g_general_parameters)+0.01 0.4 0.07], ...
                                                  'fontsize', 11, ...
                                                  'string', num2str(g_general_parameters{k}.value), ...
                                                  'handlevisibility', 'callback', ...
                                                  'callback', @general_parameters_callback);
    end

    %-------------------------

    g_init_parameters_panel = uipanel('parent', g_fh_rec, ...
                                      'title', 'Initialization parameters', ...
                                      'fontsize', 11, ...
                                      'fontweight', 'bold', ...
                                      'units', 'normalized', ...
                                      'position', [0.01 0.18 0.3 0.45]);

    g_init_parameters_label = cell(1,numel(g_init_parameters));
    g_init_parameters_edit  = cell(1,numel(g_init_parameters));

    for k=1:numel(g_init_parameters)
        g_init_parameters_label{k} = uicontrol('parent', g_init_parameters_panel, ...
                                               'style', 'text', ...
                                               'units', 'normalized', ...
                                               'position', [0.01 0.93-(k-1)/numel(g_init_parameters) 0.5 0.06], ...
                                               'fontsize', 11, ...
                                               'horizontalalignment', 'right', ...
                                               'string', [g_init_parameters{k}.label ':']);

         g_init_parameters_edit{k} = uicontrol('parent', g_init_parameters_panel, ...
                                               'style', 'edit', ...
                                               'tag', sprintf('init_%d', k), ...
                                               'units', 'normalized', ...
                                               'position', [0.55 0.93-(k-1)/numel(g_init_parameters)+0.01 0.4 0.06], ...
                                               'fontsize', 11, ...
                                               'string', num2str(g_init_parameters{k}.value), ...
                                               'handlevisibility', 'callback', ...
                                               'callback', @init_parameters_callback);
    end

    %-------------------------

    g_mpp_parameters_panel = uipanel('parent', g_fh_rec, ...
                                      'title', 'MPP parameters', ...
                                      'fontsize', 11, ...
                                      'fontweight', 'bold', ...
                                      'units', 'normalized', ...
                                      'position', [0.32 0.59 0.3 0.4]);

    g_mpp_parameters_label = cell(1,numel(g_mpp_parameters));
    g_mpp_parameters_edit  = cell(1,numel(g_mpp_parameters));

    for k=1:numel(g_mpp_parameters)
        g_mpp_parameters_label{k} = uicontrol('parent', g_mpp_parameters_panel, ...
                                              'style', 'text', ...
                                              'units', 'normalized', ...
                                              'position', [0.01 0.92-(k-1)/numel(g_mpp_parameters) 0.5 0.07], ...
                                              'fontsize', 11, ...
                                              'horizontalalignment', 'right', ...
                                              'string', [g_mpp_parameters{k}.label ':']);

         g_mpp_parameters_edit{k} = uicontrol('parent', g_mpp_parameters_panel, ...
                                              'style', 'edit', ...
                                              'tag', sprintf('mpp_%d', k), ...
                                              'units', 'normalized', ...
                                              'position', [0.55 0.92-(k-1)/numel(g_mpp_parameters)+0.01 0.4 0.07], ...
                                              'fontsize', 11, ...
                                              'string', num2str(g_mpp_parameters{k}.value), ...
                                              'handlevisibility', 'callback', ...
                                              'callback', @mpp_parameters_callback);
    end

    %-------------------------

    g_h_reconstruct_button = uicontrol('parent', g_fh_rec, ...
                                       'units', 'normalized', ...
                                       'position', [0.01 0.06 0.3 0.04], ...
                                       'style', 'pushbutton', ...
                                       'fontsize', 11, ...
                                       'string', 'Reconstruct fresco', ...
                                       'handlevisibility', 'callback', ...
                                       'callback', @reconstruct_callback);

    g_h_quit_button = uicontrol('parent', g_fh_rec, ...
                                'units', 'normalized', ...
                                'position', [0.01 0.01 0.3 0.04], ...
                                'style', 'pushbutton', ...
                                'fontsize', 11, ...
                                'string', 'Quit', ...
                                'handlevisibility', 'callback', ...
                                'callback', @quit_callback);

    %---------------------------

    % We block the window
    uiwait(g_fh_rec);

    %----------------------------------------------------------------------
    %--------------------------- Non-callbacks ----------------------------
    %----------------------------------------------------------------------

    function err = manage_parameters( parameters_struct, parameters_str, h_object, event_data )
        idx   = str2num(strrep(get(h_object, 'tag'), [parameters_str '_'], ''));
        input = get(h_object, 'string');
        name  = parameters_struct{idx}.name;
        err   = false;

        if isempty(input)
            uiwait(errordlg(sprintf('Parameter %s must be non empty', name), 'ARTEAK ERROR', 'modal'));
            err = true;
            return;
        end

        if ~isempty(str2num(input))
            input_n = str2num(input);

            if ~ismatrix(input_n)
                if isfield(parameters_struct{idx}, 'min') && input_n<parameters_struct{idx}.min
                    uiwait(errordlg(sprintf('Parameter %s must be >= %f', name, parameters_struct{idx}.min), 'ARTEAK ERROR', 'modal'));
                    err = true;
                    return;
                end

                if isfield(parameters_struct{idx}, 'max') && input_n>parameters_struct{idx}.max
                    uiwait(errordlg(sprintf('Parameter %s must be <= %f', name, parameters_struct{idx}.max), 'ARTEAK ERROR', 'modal'));
                    err = true;
                    return;
                end
            end

            parameters_struct{idx}.value = input_n;
        else
            parameters_struct{idx}.value = input;
        end
    end

    %----------------------------------------------------------------------
    %----------------------------- Callbacks ------------------------------
    %----------------------------------------------------------------------

    function err = general_parameters_callback( h_object, event_data )
        err = manage_parameters(g_general_parameters, 'general', h_object, event_data);
    end

    function err = init_parameters_callback( h_object, event_data )
        err = manage_parameters(g_init_parameters, 'init', h_object, event_data);
    end

    function err = mpp_parameters_callback( h_object, event_data )
        err = manage_parameters(g_mpp_parameters, 'mpp', h_object, event_data);
    end

    function reconstruct_callback( h_object, event_data )
        % We first check parameters
        for k=1:numel(g_general_parameters)
            if general_parameters_callback(g_general_parameters_edit{k}, [])
                return;
            end
        end

        for k=1:numel(g_init_parameters)
            if init_parameters_callback(g_init_parameters_edit{k}, [])
                return;
            end
        end

        for k=1:numel(g_mpp_parameters)
            if mpp_parameters_callback(g_mpp_parameters_edit{k}, [])
                return;
            end
        end

        % We run the reconstruction algorithm to recover a collection of fragments
        g_new_frags_sol = run_reconstruction_from_loaded_data(g_mydata.im_fresco(:,:,1:3), g_mydata.frags_infos, g_general_parameters, g_init_parameters, ...
                                                              g_mpp_parameters, g_mydata.gen_parameters, g_mydata.geometric_constraints);
        
        % We get the reconstructed frescoes
        interpolation_type                       = get_parameter_value(g_general_parameters, 'interpolation_type');
        background_color                         = get_parameter_value(g_general_parameters, 'background_color');
        [g_new_im_rec_gray,~,g_new_im_rec_color] = get_reconstructed_fresco(g_mydata.im_fresco, g_mydata.frags_infos, g_new_frags_sol, interpolation_type, background_color);
        g_new_im_rec_gray                        = cat(3, g_new_im_rec_gray, g_mydata.im_fresco(:,:,4));
        g_new_im_rec_color                       = cat(3, g_new_im_rec_color, g_mydata.im_fresco(:,:,4));
        imwrite(g_new_im_rec_color, [results_dir filesep 'final_rec_color.png']);

        % We save the reconstructed fresco image and fragments
        save_registered_fragments_list(g_new_frags_sol, frags_infos, [results_dir filesep g_mydata.true_frags_fn]);
    
        % We save the neighboring relationships between fragments
        save_fragment_neighbors(g_new_frags_sol, [results_dir filesep g_mydata.neighbors_frags_fn]);

        % We get the reconstructed fresco name
        
        [~,g_rec_name,~] = fileparts(results_dir);

        % We close the window
        close(g_fh_rec);
    end

    function quit_callback( h_object, event_data )
        delete(g_fh_rec);
    end
end