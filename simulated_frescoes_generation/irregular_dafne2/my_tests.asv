%     cmp = (d<dists);
%     dists(cmp) = d(cmp);
%     nn(cmp) = k;
% end
% im_dmap = reshape(dists, image_size);
% im_nn = reshape(nn, image_size);
toc;

%figure, imshow(im_pts,[]);
%figure, imshow(im_dmap,[]);
%figure, imshow(im_nn,[]);

